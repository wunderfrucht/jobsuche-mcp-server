{
  "name": "@wunderfrucht/jobsuche-mcp-server",
  "version": "0.3.0",
  "description": "AI-friendly job search integration server using the German Federal Employment Agency API",
  "main": "index.js",
  "bin": {
    "jobsuche-mcp-server": "./run.js"
  },
  "scripts": {
    "postinstall": "node install.js",
    "preuninstall": "node uninstall.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "job-search",
    "germany",
    "jobs",
    "rust",
    "cli"
  ],
  "author": "Ralf Anton Beier",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wunderfrucht/jobsuche-mcp-server.git"
  },
  "homepage": "https://github.com/wunderfrucht/jobsuche-mcp-server",
  "bugs": {
    "url": "https://github.com/wunderfrucht/jobsuche-mcp-server/issues"
  },
  "optionalDependencies": {
    "@wunderfrucht/jobsuche-mcp-server-darwin-arm64": "0.3.0",
    "@wunderfrucht/jobsuche-mcp-server-darwin-x64": "0.3.0",
    "@wunderfrucht/jobsuche-mcp-server-linux-x64": "0.3.0",
    "@wunderfrucht/jobsuche-mcp-server-win32-x64": "0.3.0"
  },
  "engines": {
    "node": ">=14"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "cpu": [
